# Uploaded files are data, not executable application code.
Options -ExecCGI
<FilesMatch "\.(?:php[0-9s]?|phtml|phar|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
