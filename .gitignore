# ---------------------------------------------------------------
# 敏感配置与运行期数据 —— 这些文件绝不应进入版本库
# ---------------------------------------------------------------

# 数据库配置（含账号密码，由安装向导写入）
/includes/db.php

# 安装锁
/install/install.lock

# 云更新生成物
update.json
/pre_updates/

# 发布包与构建产物
*.zip
releases/

# ---------------------------------------------------------------
# 运行期目录：只保留防护文件，忽略其余内容
# ---------------------------------------------------------------

/data/*
!/data/.htaccess
!/data/sessions/
/data/sessions/*
!/data/sessions/.gitkeep
!/data/sessions/.htaccess

/uploads/*
!/uploads/.htaccess

